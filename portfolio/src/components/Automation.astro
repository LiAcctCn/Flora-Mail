---
import SectionTitle from "./SectionTitle.astro";
import Icon from "./Icon.astro";
const levels = [
  {
    title: "Manual",
    short: "A complete GUI. AI is off.",
    heading: "You do the work. The interface is complete.",
    description:
      "Read, search, organize, and compose through conventional graphical controls. Turning assistance off does not remove the core mail workflow.",
    permission: "No AI assistance. No automation authority.",
    action: "Conventional mail controls remain available.",
  },
  {
    title: "Information",
    short: "AI helps you understand.",
    heading: "Understanding, without action.",
    description:
      "AI may provide summaries and informational previews. The interface keeps original sources available, while normal mail actions stay with the user.",
    permission: "Information and previews only.",
    action: "Review a summary. Open its original source.",
  },
  {
    title: "Suggestion",
    short: "AI proposes. You confirm.",
    heading: "A useful suggestion. An explicit decision.",
    description:
      "AI can suggest a category or prepare a writing preview. You review and accept the suggestion. External mail actions still pass through account permissions and a confirmation preview.",
    permission: "Each suggestion requires explicit acceptance.",
    action: "Accept a category or review an editable reply.",
  },
  {
    title: "Approved rules",
    short: "You define a reusable scope.",
    heading: "Repeat a decision, within a defined scope.",
    description:
      "Authorize a rule for one account, exact sender, Inbox age, Archive or Mark read action, maximum batch, and expiry. Inspect matching messages and choose Run Now. There is no background scheduler.",
    permission: "Approved rule + reviewed batch + Run Now.",
    action: "Revoke the rule to stop subsequent dispatches.",
  },
  {
    title: "Delegation",
    short: "Narrow, temporary authority.",
    heading: "A small delegation. A clear end.",
    description:
      "Create a separate one-run grant for at most ten reviewed messages, expiring within one hour. The exact preview defines its scope. Review it and choose Run Now; granting permission alone does not execute anything. There is no background scheduler. Real accounts still require their own mailbox-write permission.",
    permission: "One run · Up to 10 messages · Up to 1 hour.",
    action:
      "Revoke or cancel stops later dispatches, not requests already submitted.",
  },
];
---

<section id="automation" class="section wrap">
  <SectionTitle
    number="06"
    label="Progressive automation"
    title="More assistance. Deliberate authority."
  >
    <p>
      Automation can increase. The scope of permission is always defined by the
      user. Explore the five levels implemented in the research prototype.
    </p>
  </SectionTitle>
  <div
    class="automation-track"
    role="group"
    aria-label="Explore automation levels"
  >
    {levels.map((level, i) => (
      <button
        data-level={i}
        data-heading={level.heading}
        data-description={level.description}
        data-permission={level.permission}
        data-action={level.action}
        aria-pressed={i === 2 ? "true" : "false"}
        aria-controls="automation-detail"
      >
        <span class="level-num">LEVEL {i}</span>
        <span
          class="level-bar"
          style={`--level-height:${20 + i * 13}px`}
        ></span>
        <strong>{level.title}</strong>
        <span>{level.short}</span>
      </button>
    ))}
  </div>
  <div class="automation-direction">
    <span>More manual interaction</span>
    <span class="direction-line"></span>
    <span>More explicitly scoped assistance</span>
  </div>
  <div
    id="automation-detail"
    class="automation-detail"
    aria-live="polite"
    aria-atomic="true"
  >
    <div>
      <p class="eyebrow" data-auto-label>
        Level 2 / Suggestion
      </p>
      <h3 data-auto-heading>{levels[2].heading}</h3>
      <p data-auto-description>{levels[2].description}</p>
    </div>
    <div class="permission-card">
      <Icon name="lock" size={20} />
      <p class="eyebrow">Permission boundary</p>
      <strong data-auto-permission>{levels[2].permission}</strong>
      <p data-auto-action>{levels[2].action}</p>
    </div>
  </div>
  <noscript>
    <div class="automation-no-js">
      {levels.map((level, i) => (
        <article>
          <h3>
            Level {i} — {level.title}
          </h3>
          <p>{level.description}</p>
          <p>{level.permission}</p>
        </article>
      ))}
    </div>
  </noscript>
</section>
<script>
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-level]"),
  ];
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      buttons.forEach((other) =>
        other.setAttribute("aria-pressed", String(button === other)),
      );
      const values = {
        label: `Level ${button.dataset.level} / ${button.querySelector("strong")?.textContent}`,
        heading: button.dataset.heading,
        description: button.dataset.description,
        permission: button.dataset.permission,
        action: button.dataset.action,
      };
      Object.entries(values).forEach(([key, value]) => {
        const element = document.querySelector(`[data-auto-${key}]`);
        if (element) element.textContent = value ?? "";
      });
    }),
  );
</script>
