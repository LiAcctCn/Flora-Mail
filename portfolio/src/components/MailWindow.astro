---
import Icon from "./Icon.astro";
---

<figure class="hero-figure">
  <div class="window-stage">
    <div
      class="mail-window"
      role="img"
      aria-label="Conceptual Flora Mail interface: sidebar, inbox, and a message reader with an AI summary beside the original email. Fictional demo content."
    >
      <div class="window-toolbar">
        <span class="traffic">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span>Flora Mail</span>
        <span class="toolbar-right">
          <Icon name="search" size={15} />
          <Icon name="edit" size={15} />
        </span>
      </div>
      <div class="window-body">
        <div class="mail-sidebar">
          <div class="sidebar-title">
            <span class="brand-icon">
              <Icon name="mail" size={16} />
            </span>{" "}
            Flora
          </div>
          <div class="sidebar-item">
            <Icon name="sun" size={16} />
            Today
          </div>
          <div class="sidebar-item selected">
            <Icon name="inbox" size={16} />
            Inbox <span>16</span>
          </div>
          <div class="sidebar-item">
            <Icon name="edit" size={16} />
            Drafts <span>1</span>
          </div>
          <div class="sidebar-item">
            <Icon name="mail" size={16} />
            Sent
          </div>
          <p class="sidebar-label">CATEGORIES</p>
          <div class="sidebar-item">
            <i class="category-dot blue"></i>School
          </div>
          <div class="sidebar-item">
            <i class="category-dot green"></i>Work
          </div>
          <div class="sidebar-item">
            <i class="category-dot gold"></i>Finance
          </div>
          <div class="sidebar-bottom">
            <Icon name="lock" size={13} /> Demo Mode
          </div>
        </div>
        <div class="mail-list">
          <div class="list-title">
            Inbox <span>All messages</span>
          </div>
          <div class="message selected">
            <div>
              <strong>Professor Elaine Lin</strong>
              <time>12m</time>
            </div>
            <h3>PHYS 204 · Assignment deadline extended</h3>
            <p>The assignment deadline has changed…</p>
            <span class="message-tag">School</span>
          </div>
          <div class="message">
            <div>
              <strong>Maya Chen</strong>
              <time>38m</time>
            </div>
            <h3>Flora project · Design review</h3>
            <p>
              The updated design review is ready, including the revised inbox…
            </p>
          </div>
          <div class="message">
            <div>
              <strong>John Smith</strong>
              <time>1h</time>
            </div>
            <h3>Project sync moved to tomorrow</h3>
            <p>Our project meeting has moved to 3:00 PM tomorrow…</p>
          </div>
          <div class="list-note">
            <Icon name="lock" size={13} /> Fictional mail, stored locally
          </div>
        </div>
        <div class="mail-reader">
          <div class="reader-top">
            <span class="message-tag">School</span>
            <span>↶ &nbsp; ···</span>
          </div>
          <h3>
            Assignment deadline
            <br />
            extended.
          </h3>
          <div class="sender">
            <span class="avatar">EL</span>
            <div>
              <strong>Professor Elaine Lin</strong>
              <span>to Alex Morgan · University (Demo)</span>
            </div>
          </div>
          <div class="summary-box">
            <div class="summary-title">
              <span>
                <Icon name="spark" size={14} /> At a glance
              </span>
              <span>DEMO AI</span>
            </div>
            <p>
              Your PHYS 204 problem set is now due{" "}
              <strong>Friday at 5:00 PM.</strong> Submit it through the course
              portal.
            </p>
            <div class="quote-line">
              Source-backed summary · Original stays available
            </div>
          </div>
          <div class="original">
            <span class="original-label">ORIGINAL EMAIL</span>
            <p>Hi Alex,</p>
            <p>
              The PHYS 204 assignment deadline has changed from Thursday at 5:00
              PM to Friday at 5:00 PM.
            </p>
            <p>
              Please submit your problem set through the course portal by the
              new deadline.
            </p>
          </div>
        </div>
      </div>
      <div class="window-status">
        <span>
          <i class="status-dot"></i> Local workspace
        </span>
        <span>You stay in control.</span>
      </div>
    </div>
    <div class="frame-caption">
      <Icon name="spark" size={16} />
      <span>
        Familiar structure.
        <br />
        <strong>Thoughtfully augmented.</strong>
      </span>
    </div>
  </div>
  <figcaption>
    <span>01 / THE FLORA HYBRID EXPERIENCE</span>
    <span>Conceptual presentation · Fictional Beta demo content</span>
  </figcaption>
</figure>
