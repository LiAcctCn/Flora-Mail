---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout><section id="top" class="hero wrap"><span class="pill"><span class="dot"></span> Flora Mail – Beta <span aria-hidden="true">/</span> v0.2.0 Prerelease</span><div class="hero-copy"><div><h1>Flora Mail<span style="color:var(--green)">.</span></h1><p class="tagline">Intelligence, in its place.</p></div><div class="hero-intro"><p>A local-first, AI-augmented email client exploring how intelligence should live inside traditional graphical applications.</p><div class="hero-actions"><a class="button primary" href="#experience">Explore the project <Icon size={16} /></a><a class="button" href="#research">View research</a></div></div></div><div class="hero-meta"><span>Native macOS application</span><span>Product design · Software engineering · HCI / AI research</span></div></section><section class="section wrap" id="experience"><p class="eyebrow">01 / Product experience</p><h2>A familiar place.<br />A more thoughtful assistant.</h2></section><section class="section wrap" id="framework"><p class="eyebrow">02 / Interaction framework</p><h2>Suggest. Confirm. Execute.</h2></section><section class="section wrap" id="engineering"><p class="eyebrow">03 / Engineering</p><h2>Native by choice. Local by design.</h2></section><section class="section wrap" id="research"><p class="eyebrow">04 / Research</p><h2>Designing for Intelligence.</h2><p>A Human-Guided Framework for AI-Augmented Applications</p></section></Layout>
