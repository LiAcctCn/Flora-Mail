---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import MailWindow from "../components/MailWindow.astro";
import Philosophy from "../components/Philosophy.astro";
import Experience from "../components/Experience.astro";
import LocalAI from "../components/LocalAI.astro";
import HumanControl from "../components/HumanControl.astro";
import Automation from "../components/Automation.astro";
import Engineering from "../components/Engineering.astro";
import Research from "../components/Research.astro";
import Journey from "../components/Journey.astro";
import "../styles/case-study.css";
import "../styles/research.css";
---

<Layout>
  <section id="top" class="hero wrap">
    <span class="pill">
      <span class="dot"></span> Flora Mail – Beta{" "}
      <span aria-hidden="true">/</span> v0.2.0 Prerelease
    </span>
    <div class="hero-copy">
      <div>
        <h1>
          Flora Mail<span style="color:var(--green)">.</span>
        </h1>
        <p class="tagline">Intelligence, in its place.</p>
      </div>
      <div class="hero-intro">
        <p>
          A local-first, AI-augmented email client exploring how intelligence
          should live inside traditional graphical applications.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#experience">
            Explore the project <Icon size={16} />
          </a>
          <a class="button" href="#research">
            View research
          </a>
        </div>
      </div>
    </div>
    <MailWindow />
    <div class="hero-meta">
      <span>Native macOS application</span>
      <span>Product design · Software engineering · HCI / AI research</span>
    </div>
  </section>
  <Philosophy />
  <Experience />
  <LocalAI />
  <HumanControl />
  <Automation />
  <Engineering />
  <Research />
  <Journey />
</Layout>
